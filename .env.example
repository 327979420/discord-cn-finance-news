# Discord 频道 Webhook（必须）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_USERNAME=情报助手
DISCORD_AVATAR_URL=

# OpenAI（抓英文源并翻译成中文时需要；只抓中文 RSS 时可暂时留空）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 运行参数
CONFIG_PATH=config/sources.json
DATABASE_PATH=data/news.db
POLL_INTERVAL_SECONDS=120
MAX_NEWS_AGE_MINUTES=180
MAX_ITEMS_PER_CYCLE=8
REQUEST_TIMEOUT_MS=20000
DRY_RUN=false
RUN_ONCE=false
PORT=3000

# 文案与展示
DEFAULT_PREFIX=快讯
INCLUDE_SOURCE_URL=false
MAX_CHINESE_CHARS=110

# 关键词：留空代表不过滤。逗号分隔，中英文均可。
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=广告,促销,优惠券
